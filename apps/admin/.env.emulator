# Firebase Emulator mode — real SDK, local Firestore
# Run: firebase emulators:start --only firestore
# Then: cp apps/admin/.env.emulator apps/admin/.env && pnpm dev:admin

FIREBASE_API_KEY=local-api-key
FIREBASE_AUTH_DOMAIN=sass-factory-local.firebaseapp.com
FIREBASE_PROJECT_ID=sass-factory-local
FIREBASE_STORAGE_BUCKET=sass-factory-local.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Tells Firebase SDK to use the local emulator instead of production
FIRESTORE_EMULATOR_HOST=localhost:8080
