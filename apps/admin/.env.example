# ─── Firebase (Client SDK) ────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your Apps → Web App
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── GCP / Cloud Build ────────────────────────────────────────────────────
# The GCP project where the SASS Factory admin itself runs
GCP_PROJECT_ID=

# The public URL of the deployed SASS Factory admin (Cloud Run URL)
# Used by Cloud Build pipelines to call back and update deploy status
FACTORY_URL=https://your-factory-url.run.app

# GCS bucket name for Terraform remote state
# Convention: {GCP_PROJECT_ID}-tf-state
TF_STATE_BUCKET=your-factory-project-tf-state

# Source repository name in Cloud Source Repositories (or GitHub via mirror)
CLOUD_BUILD_REPO=sass-factory

# ─── Firestore Emulator (local dev only) ─────────────────────────────────
# Uncomment to use Firebase Local Emulator instead of real Firestore
# FIRESTORE_EMULATOR_HOST=localhost:8080
