# URL of the admin app — where "Crear mi catálogo" links to
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173
# URL of the storefront — where demo links point to
NEXT_PUBLIC_STORE_URL=http://localhost:3000
# URL of the identity API — handles claims and one-time auth exchanges
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:8001

# Firebase Web app registered in the same project used by identity-api
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ei-catalog-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ei-catalog-dev
