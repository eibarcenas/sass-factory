# ─── App Identity ─────────────────────────────────────────────────────────
# Set by the dev launcher or Docker --env flag
APP_SLUG=love

# ─── Firebase (same project as admin, or separate) ────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Docker (set automatically when container is launched) ────────────────
# Path inside the container where .dev-configs/{slug}.json is mounted
# DEV_CONFIGS_DIR=/dev-configs
